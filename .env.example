# Copy to .env (never commit it). Secrets may also be stored in the OS keyring under service "jarvis".

# --- Language model -------------------------------------------------------------------
# auto: Anthropic if a key is present, else OpenAI-compatible if configured, else offline engine.
JARVIS_LLM_PROVIDER=auto              # auto | anthropic | openai_compat | offline
ANTHROPIC_API_KEY=
JARVIS_ANTHROPIC_MODEL=claude-opus-5-5
JARVIS_ANTHROPIC_EFFORT=medium        # low | medium | high | xhigh | max
# Local / other models through any OpenAI-compatible server (Ollama: http://127.0.0.1:11434/v1)
JARVIS_OPENAI_BASE_URL=
JARVIS_OPENAI_MODEL=
OPENAI_API_KEY=

# --- Agent behaviour ----------------------------------------------------------------------
JARVIS_AGENT_MODE=auto                # auto | flat | team. flat = one agent, fewer model calls (auto picks it for local models)
JARVIS_MAX_TOOLS=12                   # tools shown to the model per step (smaller = faster and fewer mistakes on small models)
JARVIS_LLM_TIMEOUT=300                # seconds to wait for one model reply before falling back to the rule engine
JARVIS_OPENAI_STREAM=1                # 0 if your local server cannot stream
JARVIS_OPENAI_KEEP_ALIVE=             # Ollama: keep the model loaded this long (default 2h; JARVIS re-warms it while running). Empty = default

# --- Calendar and email (optional) ----------------------------------------------------------
JARVIS_CALENDAR_ICS=                  # comma-separated .ics files or secret iCal URLs (Google/Outlook "secret address in iCal format")
JARVIS_EMAIL_ADDRESS=
JARVIS_IMAP_HOST=                     # e.g. imap.gmail.com / outlook.office365.com
JARVIS_SMTP_HOST=                     # e.g. smtp.gmail.com / smtp.office365.com
JARVIS_SMTP_PORT=587
JARVIS_EMAIL_PASSWORD=                # an APP PASSWORD, not your login password. Prefer the OS keyring over this file.

# --- Scope and storage ------------------------------------------------------------------
JARVIS_ALLOWED_ROOTS=                 # os.pathsep-separated folders JARVIS may see. Default: your home directory
JARVIS_BLOCKED_PATHS=                 # folders inside those it must never read, list or search (same separator)
JARVIS_DATA_DIR=~/.jarvis
JARVIS_HOST=127.0.0.1                 # keep on loopback
JARVIS_PORT=8765

# --- Research ---------------------------------------------------------------------------
JARVIS_SEARCH_PROVIDER=duckduckgo     # duckduckgo | wikipedia (the other is used as fallback)

# --- Knowledge --------------------------------------------------------------------------
JARVIS_EMBEDDER=hashing               # hashing (built in, lexical) | openai:<model> via JARVIS_OPENAI_BASE_URL

# --- Voice ------------------------------------------------------------------------------
JARVIS_WAKE_WORD=jarvis
JARVIS_STT_PROVIDER=browser           # browser | openai_compat
JARVIS_TTS_PROVIDER=browser           # browser | openai_compat
JARVIS_VOICE_BASE_URL=                # e.g. a local faster-whisper / Kokoro server exposing /v1/audio/*
JARVIS_VOICE_API_KEY=
JARVIS_STT_MODEL=whisper-1            # model name your speech-to-text server expects
JARVIS_TTS_MODEL=tts-1                # model name your text-to-speech server expects
JARVIS_TTS_VOICE=alloy                # voice name your text-to-speech server expects

# --- Image generation (local) -----------------------------------------------------------
JARVIS_IMAGE_PROVIDER=none            # none | automatic1111 | openai_compat
JARVIS_IMAGE_BASE_URL=                # automatic1111: http://127.0.0.1:7860   openai_compat: http://127.0.0.1:8080/v1
JARVIS_IMAGE_MODEL=
